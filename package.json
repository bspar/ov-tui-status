{
  "name": "ov-tui-status",
  "version": "0.1.0",
  "private": false,
  "description": "Bounded OpenViking recall and memory-extraction status UI for OpenCode",
  "type": "module",
  "oc-plugin": [
    "tui"
  ],
  "exports": {
    ".": "./tui.ts",
    "./tui": "./tui.ts"
  },
  "files": [
    "tui.ts",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.18",
    "@opentui/core": ">=0.5.12",
    "@opentui/solid": ">=0.5.12",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.18",
    "@opencode/theme": "^2.0.18",
    "@opentui/core": "0.5.12",
    "@opentui/solid": "0.5.12",
    "@types/node": "^22.20.4",
    "solid-js": "1.9.12",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0"
}
